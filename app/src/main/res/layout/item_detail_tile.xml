<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/bg_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AllClear.TileLabel" />

        <TextView
            android:id="@+id/tileValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/no_data"
            android:textAppearance="@style/TextAppearance.AllClear.TileValue" />
    </LinearLayout>

    <ImageView
        android:id="@+id/tileIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:alpha="0.7"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_na"
        android:tint="@color/white" />

</LinearLayout>
